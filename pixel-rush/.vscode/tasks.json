{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Pixel Rush",
            "type": "process",
            "command": "C:\MinGW\bin\g++.exe",
            "args": [
                "${workspaceFolder}\\main.cpp",
                "-o",
                "${workspaceFolder}\\jogo.exe",
                "-IC:\\raylib\\include",
                "-LC:\\raylib\\lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-Wl,--defsym,stat64i32=_stat64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
